<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <VSVersion Condition="'$(VSVersion)' == ''">1.22.7</VSVersion>
    <TargetFramework>net10.0</TargetFramework>
    <GameDirectory>$(GameDirectory_1_22_7)</GameDirectory>
    <OutputType>Exe</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>bin/$(VSVersion)</OutputPath>
    <AssemblyName>Mechanical.Tests</AssemblyName>
  </PropertyGroup>
  <PropertyGroup>
    <GameDirectory Condition="'$(GameDirectory)' == ''">$(VINTAGE_STORY_1_22_7)</GameDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Reference Include="VSMechanicalLocks" HintPath="../bin/Debug/$(VSVersion)/Mods/vsmechanicallocks/VSMechanicalLocks.dll" />
    <Reference Include="VintagestoryAPI" HintPath="$(GameDirectory)/VintagestoryAPI.dll" />
    <Reference Include="VintagestoryLib" HintPath="$(GameDirectory)/VintagestoryLib.dll" />
    <Reference Include="VSSurvivalMod" HintPath="$(GameDirectory)/Mods/VSSurvivalMod.dll" />
    <Reference Include="VSEssentials" HintPath="$(GameDirectory)/Mods/VSEssentials.dll" />
    <Reference Include="Newtonsoft.Json" HintPath="$(GameDirectory)/Lib/Newtonsoft.Json.dll" />
    <Reference Include="0Harmony" HintPath="$(GameDirectory)/Lib/0Harmony.dll" />
    <Reference Include="cairo-sharp" HintPath="$(GameDirectory)/Lib/cairo-sharp.dll" />
  </ItemGroup>
</Project>
